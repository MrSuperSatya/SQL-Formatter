    "from sql_formatter import format_sql"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "efed8aad",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "select\n",
      "\tc.CUSTOMER_ID, c.CUSTOMER_NAME, l.TOTAL_BALANCE\n",
      "from\n",
      "\tCUSTOMERS c\n",
      "\tinner join (\n",
      "\t\tselect CUSTOMER_ID, SUM(BALANCE) as TOTAL_BALANCE\n",
      "\t\tfrom LOANS l1\n",
      "\t\tgroup by CUSTOMER_ID\n",
      "\t) l on c.CUSTOMER_ID = l.CUSTOMER_ID\n",
      "where\n",
      "\tl.TOTAL_BALANCE > (\n",
      "\t\tselect avg(TOTAL_BALANCE)\n",
      "\t\tfrom\n",
      "\t\t\t(\n",
      "\t\t\t\tselect CUSTOMER_ID, SUM(BALANCE) as TOTAL_BALANCE\n",
      "\t\t\t\tfrom LOANS l1\n",
      "\t\t\t\tgroup by CUSTOMER_ID\n",
      "\t\t\t) x\n",
      "\t)\n",
      "order by\n",
      "\tl.TOTAL_BALANCE desc;\n",
      "\n",
      "select\n",
      "\t*\n",
      "from\n",
      "\tCUSTOMER_ORDERS co\n",
      "where\n",
      "\tCUSTOMER_ID in (1, 2);\n",
      "\n"
     ]
    }
   ],
   "source": [
    "with open(\"sample SQL.sql\", \"r\", encoding=\"utf-8\") as file:\n",
    "    sql_code = file.read()\n",
    "\n",
    "print(format_sql(sql_code))"
   ]
